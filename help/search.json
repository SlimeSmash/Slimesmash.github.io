[
{%- for d in site.help -%}
{ "title": {{ d.title | jsonify }}, "url": {{ d.url | jsonify }}, "category": {{ d.category | jsonify }}, "summary": {{ d.summary | default: "" | jsonify }}, "text": {{ d.content | strip_html | normalize_whitespace | truncate: 600 | jsonify }} }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
{%- if site.help.size > 0 and site.data.faq.size > 0 -%},{%- endif -%}
{%- for f in site.data.faq -%}
{ "title": {{ f.q | jsonify }}, "url": "/help/faq/#faq-{{ forloop.index }}", "category": "faq", "summary": "", "text": {{ f.a | markdownify | strip_html | normalize_whitespace | truncate: 600 | jsonify }} }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
